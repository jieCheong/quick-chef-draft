# .env.docker
#
# NOT USED — docker-compose.yml at the project root loads OPENAI_API_KEY
# directly from server/.env via `env_file:`, so no manual export or extra
# file is needed. Just run `docker-compose up --build` from the project
# root and it picks up the real key automatically. This file is kept only
# as a reference for what env_file pulls in; edit server/.env, not this.

OPENAI_API_KEY=sk-replace-with-your-real-key
JWT_SECRET=replace-with-a-long-random-string-for-local-dev
